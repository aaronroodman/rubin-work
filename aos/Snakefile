# ----------------------------------------------------------------------
# AOS FAM pipeline (Snakemake).  Phase 1: mktable + fit per chunk ->
# combine -> analyses, organised under output/<study>/<data>/.
#
# Config: snake_config.yaml (param_sets -> date chunks); Butler/collection
# definitions in param_sets.yaml (referenced by name).
#
#   snakemake -n                 # dry-run: show the plan
#   snakemake -j4                # build (4 parallel; add --resources mem_mb=... on RSP)
#   snakemake --dag | dot -Tpng > dag.png
#
# Layout — study outermost, ONE data level, the data axes joined into one
# directory name (root CLAUDE.md "Output conventions"):
#   output/fam_processing/<P>/chunks/<dmin>_<dmax>/{donuts,fits,visits}.parquet
#   output/fam_processing/<P>/{donuts,fits,visits}.parquet          (combined)
#   output/miw/<P>_<M>/                                             (the MIW build)
#   output/<study>/<P>/           studies depending on the param_set only
#   output/<study>/<P>_<M>/       studies depending on param_set + MIW build
#   output/<study>/<P>[_<M>]/<C>/ CWFS studies: the cwfs variant nests
#
# <P> and <M> are the SHORT directory names (`dir_name` in param_sets.yaml /
# mi_config.yaml), not the param_set / mi_name keys; see the resolvers below.
# ----------------------------------------------------------------------
import os
import sys

import yaml

# Deterministic threading regardless of how the launching terminal set these.
# A NUMEXPR_MAX_THREADS pinned to 1 (some JupyterHub sessions) crashes mktable;
# force a safe cap.  One thread per job — parallelism comes from `snakemake -j`
# (the RSP terminal gets ~4 usable cores via the cgroup cpu quota), so this
# fills the cores without N_jobs x N_threads oversubscription.  Set in the
# Snakefile process env, which the rule shell subprocesses inherit.
os.environ['NUMEXPR_MAX_THREADS'] = '8'
os.environ['NUMEXPR_NUM_THREADS'] = '1'
os.environ['OMP_NUM_THREADS'] = '1'
os.environ['OPENBLAS_NUM_THREADS'] = '1'
os.environ['MKL_NUM_THREADS'] = '1'

PARAM_SETS = yaml.safe_load(open("param_sets.yaml"))
_SNAKE     = yaml.safe_load(open("snake_config.yaml"))
CFG        = _SNAKE["param_sets"]
MKT        = _SNAKE.get("mktable", {})     # run_mktable knobs: workers, no_thermal
PSETS      = list(CFG)

# Core MIW library + runners now live in the installed ts_intrinsic_wavefront
# package (set up via ~/notebooks/.user_setups).  rubin-work is a thin client:
# it imports the package library and calls the package's built runners, keeping
# only its analysis/WFS/study scripts locally in code/.
from lsst.ts.intrinsic.wavefront import mi_config as _mc

# Package runner (bin/) and library (python/lsst/...) dirs, from the eups setup.
# The eups table exports TS_INTRINSIC_WAVEFRONT_DIR; the bin/ shims are built by
# `scons` (bin/ is NOT auto-added to PATH, so reference it explicitly).
_WF_DIR = os.environ["TS_INTRINSIC_WAVEFRONT_DIR"]
WF_BIN  = f"{_WF_DIR}/bin"
WF_LIB  = f"{_WF_DIR}/python/lsst/ts/intrinsic/wavefront"

MI_DOC = _mc.load_doc("mi_config.yaml") if os.path.exists("mi_config.yaml") else {}
MI_PSETS = list((MI_DOC or {}).get("measured_intrinsics", {}))

# The attach_telemetry switch moved with its rule into the fam_tables product's
# Snakefile. run_snake.sh --mode batch still passes --config attach_telemetry=0,
# which snakemake accepts and nothing here reads.

def phrase(ps):                                   # matches run_pipeline / intrinsics_lib
    r = PARAM_SETS.get(ps, {})
    if r.get("collection_phrase"):
        return r["collection_phrase"]
    parts = r["fam_collections"][0].split("/")
    return parts[2] if (parts[0] == "u" and len(parts) > 2) else r["fam_collections"][0]

# ---- name translation: config KEY -> output DIRECTORY name ----------------
# The param_set and mi_name keys are the identity (what --param-set / --mi-name
# take, what the value_added DB rows carry, what frozen provenance resolves
# against), and two of them are long for historical reasons.  `dir_name` in
# param_sets.yaml / mi_config.yaml supplies a short string for the path only,
# exactly as `collection_phrase` above does for the Butler collection.  Absent
# -> the key itself, so a param_set that is already short needs no entry.
#
# Consequence: the WILDCARDS carry the SHORT names, because they come from the
# output paths — {ps} is a param_set's dir_name and {d} is the JOINED
# param_set+mi_name pair (the two axes are one directory name, so there is no
# separate {mi}).  Every rule therefore translates back with PS_BY_DIR /
# MI_BY_DTAG before invoking a script, and tells the script its output
# directory rather than letting it re-derive one from the key.
def ps_dir(ps):
    return PARAM_SETS.get(ps, {}).get("dir_name") or ps

def mi_dir(ps, mi):
    return _mc.dir_name(_mc.load_mi_config(ps, mi, doc=MI_DOC), mi)

# A chunk is a finite SET OF VISITS, not necessarily one collection.  Each
# snake_config chunk is either a bare [dmin, dmax] pair (uses the param_set's
# fam_collections) or a dict {day_obs: [dmin, dmax], collection:, phrase:,
# butler_repo:, programs:} that targets its OWN Butler collection for that set of
# visits.  All chunks of a param_set land in the SAME output/fam_processing/<P>/
# area (combine concatenates them), so a newer disjoint reprocessing can be
# folded in as one extra chunk without a new param_set or output dir.
# A param_set absent from snake_config.yaml declares no chunks: its combined
# tables were produced outside this pipeline (the Danish 1.3 blitz recast writes
# output/fam_processing/<P>/{donuts,visits,fits}.parquet directly).  Those tables
# are then TERMINAL inputs -- there is nothing for combine_* or mktable to build
# -- so return no chunk entries rather than raising KeyError while the DAG is
# planned.  Requesting a chunk-fanout target for such a param_set still fails,
# correctly, on the empty input list.
def _chunk_entries(ps):
    out = []
    for c in (CFG.get(ps) or {}).get("chunks", []):
        if isinstance(c, dict):
            a, b = c["day_obs"]
            out.append(dict(dmin=int(a), dmax=int(b), collection=c.get("collection"),
                            phrase=c.get("phrase"), butler_repo=c.get("butler_repo"),
                            programs=c.get("programs")))
        else:
            a, b = c
            out.append(dict(dmin=int(a), dmax=int(b), collection=None,
                            phrase=None, butler_repo=None, programs=None))
    return out

def chunks(ps):  return [(c["dmin"], c["dmax"]) for c in _chunk_entries(ps)]
def coord(ps):   return (CFG.get(ps) or {}).get("coord_sys", "OCS")
def chunk_files(psd, name):
    # PS_BY_DIR covers only the param_sets snake_config.yaml drives; fall back to
    # the dir_name itself for one built outside the pipeline, which then resolves
    # to no chunks (see _chunk_entries).
    return [f"output/fam_processing/{psd}/chunks/{a}_{b}/{name}"
            for a, b in chunks(PS_BY_DIR.get(psd, psd))]

def _chunk_at(ps, dmin, dmax):
    for c in _chunk_entries(ps):
        if c["dmin"] == int(dmin) and c["dmax"] == int(dmax):
            return c
    return dict(collection=None, phrase=None, butler_repo=None, programs=None)

def chunk_phrase(ps, dmin, dmax):
    # phrase drives run_mktable's output filename ({phrase}_{dmin}_{dmax}.parquet)
    return _chunk_at(ps, dmin, dmax)["phrase"] or phrase(ps)

def chunk_mktable_extra(ps, dmin, dmax):
    # CLI overrides for a per-chunk collection; empty string for legacy chunks
    # (so their mktable command — and Butler query — is unchanged).
    c = _chunk_at(ps, dmin, dmax)
    if not c["collection"]:
        return ""
    parts = ["--collections", c["collection"],
             "--collection-phrase", chunk_phrase(ps, dmin, dmax)]
    if c["butler_repo"]:
        parts += ["--butler-repo", c["butler_repo"]]
    if c["programs"]:
        parts += ["--programs", *[str(p) for p in c["programs"]]]
    return " ".join(parts)

# ---- Phase 2 (measured intrinsic) helpers, driven by mi_config.yaml ----
def mi_names(ps):   return _mc.mi_names(ps, doc=MI_DOC)
def mi_rotbins(ps, mi): return _mc.rotator_bins(_mc.load_mi_config(ps, mi, doc=MI_DOC))
def mi_build_src(ps, mi):
    # entry whose build grids to read (build_from -> reuse a parent's grids)
    return _mc.build_source(_mc.load_mi_config(ps, mi, doc=MI_DOC), mi)

# Since phase 3a moved build_intrinsic, intrinsic_split, intrinsic_sidecar,
# wfs_intrinsic_sidecar and refit_mi into the miw product, the MIW tables are INPUTS this
# Snakefile does not build.  A (param_set, mi_name) pair whose build is absent therefore
# has no producer here and would abort the WHOLE DAG with MissingInputException, exactly as
# the never-built refitWcs_2025 CWFS variant did -- but for nine of the twelve pairs, since
# most were only ever taken as far as the split.  So enumerate only the pairs whose MIW is
# complete, and REPORT every skip: a dropped pair silently drops its study jobs.
#
# `fits.parquet` and `zk_intrinsic.parquet` are the gate because every study rule here
# reads one or the other.  A pair with a split but no sidecar is incomplete, not partially
# usable.  Build a missing one with the product Snakefile:
#
#   snakemake -s rubinwork/products/miw/Snakefile \
#       --config variant=<v> build=<YYYYMMDD> fam_build=<FAM build>
#
# and it reappears here.
MI_REQUIRED = ("fits.parquet", "zk_intrinsic.parquet")
_MI_SKIPPED = {}
def _mi_complete(ps, mi):
    d = f"{ps_dir(ps)}_{mi_dir(ps, mi)}"
    missing = [f for f in MI_REQUIRED if not os.path.exists(f"output/miw/{d}/{f}")]
    if missing:
        _MI_SKIPPED[d] = missing
        return False
    return True
MI_PAIRS = [(ps, mi) for ps in MI_PSETS for mi in mi_names(ps)
            if _mi_complete(ps, mi)]
if _MI_SKIPPED:
    print(f"[Snakefile] skipping {len(_MI_SKIPPED)} MIW build(s) with no complete output "
          "on disk; their study jobs (study_radialbins, wfs_dof_compare, wfs_mimic, "
          "build_lut, the four correlations rules, bounce, fam_coadd_miw) are NOT "
          "planned. Build each with `snakemake -s rubinwork/products/miw/Snakefile "
          "--config variant=<v> build=<YYYYMMDD>` from the repository root.",
          file=sys.stderr)
    for d, missing in sorted(_MI_SKIPPED.items()):
        print(f"[Snakefile]   {d}: missing {', '.join(missing)}", file=sys.stderr)

# param_sets with paired in-focus corner-WFS (cwfs) collections.  Each ps may
# carry several CWFS variants (wfs_collections: name -> Butler collection); the
# name is the {cwfs} wildcard and nests one level under the joined data dir,
# e.g.  output/wfs_ingest/<P>/<name>/ .
#
# Since phase 3a moved `wfs_mktable` into the cwfs_tables product, these tables are
# INPUTS this Snakefile does not build, so a variant with no tables on disk has no
# producer here and would abort the whole DAG with MissingInputException.  Enumerate only
# the variants that are actually ingested; `refitWcs_2025` has never been built.  Build a
# missing one with the product Snakefile (see the note where rule wfs_mktable used to be),
# and it reappears here.
#
# Silently dropping a variant would silently drop its study jobs, so every skip is
# reported once while the DAG is built.  wfs_variants() is called several times (WFS_PSETS
# and the two *_DVARIANTS lists below), so the skips are accumulated and printed from
# _report_wfs_skips() after the last call rather than per call.
_WFS_SKIPPED = {}
def wfs_variants(ps):
    defined = list(PARAM_SETS.get(ps, {}).get("wfs_collections", {}))
    d = ps_dir(ps)
    have = []
    for cw in defined:
        table = f"output/wfs_ingest/{d}/{cw}/donuts.parquet"
        if os.path.exists(table):
            have.append(cw)
        else:
            _WFS_SKIPPED[(d, cw)] = table
    return have
def wfs_collection(ps, cw):                       # entry is a str or {collection, ...}
    e = PARAM_SETS[ps]["wfs_collections"][cw]
    return e["collection"] if isinstance(e, dict) else e
WFS_PSETS = [ps for ps in PSETS if wfs_variants(ps)]

def _report_wfs_skips():
    if not _WFS_SKIPPED:
        return
    n = len(_WFS_SKIPPED)
    print(f"[Snakefile] skipping {n} CWFS variant(s) with no donuts.parquet on disk; "
          "their wfs_corner_compare and wfs_dof_compare jobs are NOT planned. Build each "
          "with `snakemake -s rubinwork/products/cwfs_tables/Snakefile "
          "--config variant=<v> build=<YYYYMMDD>` from the repository root.",
          file=sys.stderr)
    for (d, cw), table in sorted(_WFS_SKIPPED.items()):
        print(f"[Snakefile]   {d}/{cw}: missing {table}", file=sys.stderr)

# ---- the data-axis directory names, and the inverse maps back to the keys ----
# Rules see only the short names (they come out of the output paths), so every
# rule that invokes a script recovers the real key here.  A duplicate dir_name
# would silently merge two param_sets' output into one directory, so assert
# injectivity at load time and fail loudly instead.
def dtag(ps, mi=None):                     # joined data-axis directory name
    return f"{ps_dir(ps)}_{mi_dir(ps, mi)}" if mi else ps_dir(ps)

PS_DIRS  = [ps_dir(ps) for ps in PSETS]
assert len(set(PS_DIRS)) == len(PS_DIRS), \
    f"duplicate param_set dir_name in param_sets.yaml: {sorted(PS_DIRS)}"
PS_BY_DIR = {ps_dir(ps): ps for ps in PSETS}

MI_DTAGS = [dtag(ps, mi) for ps, mi in MI_PAIRS]
assert len(set(MI_DTAGS)) == len(MI_DTAGS), \
    f"duplicate (param_set, mi_name) dir_name pair: {sorted(MI_DTAGS)}"
# dtag -> (real param_set, real mi_name); the ONE wildcard {d} carries both axes.
MI_BY_DTAG = {dtag(ps, mi): (ps, mi) for ps, mi in MI_PAIRS}

def d_ps_dir(d):                       # the param_set dir of a joined dtag
    return ps_dir(MI_BY_DTAG[d][0])

def d_tables(d):                       # phase-1 tables dir for a joined dtag
    return f"output/fam_processing/{d_ps_dir(d)}"

def d_wfs(d, cwfs):                    # ingested CWFS dir for a joined dtag
    return f"output/wfs_ingest/{d_ps_dir(d)}/{cwfs}"

WFS_DVARIANTS    = [(ps_dir(ps), cw) for ps in WFS_PSETS for cw in wfs_variants(ps)]
_report_wfs_skips()          # after the last wfs_variants() call, so the list is complete

# wfs_dof_compare reads the CWFS MIW corner sidecar, whose producer
# (wfs_intrinsic_sidecar) moved into the miw product in phase 3a, so that sidecar is now an
# INPUT this Snakefile does not build -- and `tarts` never had one built, though its CWFS
# donuts exist.  Filter on the sidecar as well, and report, for the same reason as above.
_SIDECAR_SKIPPED = {}
def _has_corner_sidecar(d, cw):
    path = f"output/wfs_dof_compare/{d}/{cw}/zk_intrinsic.parquet"
    if os.path.exists(path):
        return True
    _SIDECAR_SKIPPED[(d, cw)] = path
    return False
WFS_MI_DVARIANTS = [(dtag(ps, mi), cw) for ps, mi in MI_PAIRS if ps in WFS_PSETS
                    for cw in wfs_variants(ps)
                    if _has_corner_sidecar(dtag(ps, mi), cw)]
if _SIDECAR_SKIPPED:
    print(f"[Snakefile] skipping {len(_SIDECAR_SKIPPED)} wfs_dof_compare job(s) with no "
          "CWFS MIW corner sidecar on disk. Build it with the miw product Snakefile, "
          "which writes <products>/miw/<v>/<build>/wfs/<cwfs>/zk_intrinsic.parquet.",
          file=sys.stderr)
    for (d, cw), path in sorted(_SIDECAR_SKIPPED.items()):
        print(f"[Snakefile]   {d}/{cw}: missing {path}", file=sys.stderr)

def mi_bin_grids(d):
    # grids come from the build SOURCE entry; bins are the source's bins so the
    # paths point at already-built grids (a build_from entry triggers no build).
    ps, mi = MI_BY_DTAG[d]
    src = mi_build_src(ps, mi)
    return [f"output/miw/{dtag(ps, src)}/build/rot_{lo:g}_{hi:g}/intrinsic_grid.parquet"
            for lo, hi in mi_rotbins(ps, src)]

def src_miw_dir(d):
    # the MIW directory holding this entry's build grids (self, or its build_from
    # parent's) — what run_intrinsic_split reads via --src-dir.
    ps, mi = MI_BY_DTAG[d]
    return f"output/miw/{dtag(ps, mi_build_src(ps, mi))}"

# Config-as-params (not config-as-input): pass the RESOLVED per-(ps, mi) config
# as a Snakemake `params` value rather than listing mi_config.yaml /
# analysis_config.yaml as rule inputs.  Snakemake's `params` rerun-trigger then
# fires only when THIS entry's resolved settings change — so adding or editing
# another param_set (or an unrelated analysis section) no longer invalidates
# this rule via the shared file's mtime.  Canonical JSON keeps the hash stable.
import json as _json
AN_DOC = (_mc.load_analysis_doc("analysis_config.yaml")
          if os.path.exists("analysis_config.yaml") else {})

# These take the joined data-axis dir name {d} and resolve it back to the real
# (param_set, mi_name) the config is keyed on.
def mi_cfg_json(d):
    ps, mi = MI_BY_DTAG[d]
    return _json.dumps(_mc.load_mi_config(ps, mi, doc=MI_DOC),
                       sort_keys=True, default=str)

def an_json(section, ps, mi=None):
    return _json.dumps(_mc.analysis_section(section, ps, mi, doc=AN_DOC),
                       sort_keys=True, default=str)

def an_json_d(section, d):                         # by joined dir name
    return an_json(section, *MI_BY_DTAG[d])

def an_sec(section, ps, mi=None):                  # resolved analysis section (dict)
    return _mc.analysis_section(section, ps, mi, doc=AN_DOC)

def an_sec_d(section, d):                          # by joined dir name
    return an_sec(section, *MI_BY_DTAG[d])

# Directory names have no slash; keeps output/fam_processing/<ps>/X.parquet
# (combined) distinct from .../chunks/<d>_<d>/X.parquet (per chunk).  {ps} is the
# param_set's short dir_name; {d} is the joined param_set+mi_name dir name.
wildcard_constraints:
    ps   = r"[A-Za-z0-9_.+-]+",
    dmin = r"\d{8}",
    dmax = r"\d{8}",
    d    = r"[A-Za-z0-9_.+-]+",
    cwfs = r"[A-Za-z0-9_.+-]+",
    lo   = r"-?\d+(\.\d+)?",
    hi   = r"-?\d+(\.\d+)?",

rule all:
    input:
        # The FAM tables themselves are the fam_tables PRODUCT and are built by
        # rubinwork/products/fam_tables/Snakefile, not here, so they are not
        # targets of this Snakefile.  The study rules below read them.
        expand("output/dzfit/{ps}/trio_comparison_all.pdf", ps=PS_DIRS),
        # k<=3 vs k<=6 DZ fit check: residual metrics + plots
        expand("output/dzfit/{ps}/dz_fit_check.pdf", ps=PS_DIRS),
        # per-donut aberration-pair (primary->secondary) analysis
        expand("output/correlations/{ps}/aberration_pairs.pdf", ps=PS_DIRS),
        # measured-intrinsic at the WFS radius, per rotator bin (pre-split)
        expand("output/miw/{d}/study_radialbins.pdf", d=MI_DTAGS),
        # corner-by-corner CWFS vs FAM measured-OPD comparison (per ps, cwfs)
        [f"output/wfs_corner_compare/{p}/{cw}/wfs_corner_compare.pdf"
         for p, cw in WFS_DVARIANTS],
        # CWFS vs FAM optical state (v-modes + DoF) per image (per ps+mi, cwfs)
        [f"output/wfs_dof_compare/{d}/{cw}/wfs_dof_compare_offsets.pdf"
         for d, cw in WFS_MI_DVARIANTS],
        # FAM-derived corner-WFS deviation covariance (84x84 + 21x21) per ps+mi
        expand("output/wfs_mimic/{d}/wfs_mimic_cov84.parquet", d=MI_DTAGS),
        # Phase 2: measured-intrinsic refit per (param_set, mi_name)
        expand("output/miw/{d}/fits.parquet", d=MI_DTAGS),
        # averaged-DOF LUT per (param_set, mi_name)
        expand("output/lut/{d}/lut.parquet", d=MI_DTAGS),
        # MI-refit analyses: DZ-DZ + DZ-temperature correlations, bounce tests
        expand("output/correlations/{d}/dz_correlations.pdf", d=MI_DTAGS),
        expand("output/correlations/{d}/dz_correlations_optcorr.pdf", d=MI_DTAGS),
        expand("output/correlations/{d}/thermal_correlations.pdf", d=MI_DTAGS),
        expand("output/correlations/{d}/vmode_correlations_50_34.pdf", d=MI_DTAGS),
        expand("output/correlations/{d}/vmode_correlations_22_12.pdf", d=MI_DTAGS),
        expand("output/correlations/{d}/dz_explained.pdf", d=MI_DTAGS),
        expand("output/bounce/{d}/bounce_kj_stats.parquet", d=MI_DTAGS),

# ---- FAM tables: mktable / fit / combine_* / attach_telemetry moved out ----
# Phase 2 of notes/status/organization_plan.md moved these six rules into the
# fam_tables product, rubinwork/products/fam_tables/Snakefile, which writes into
# the product data root.  The rules below still READ the FAM tables at the paths
# they always did -- output/fam_processing/<P>/{donuts,visits,fits}.parquet in
# this old tree -- so those three files are now INPUTS this Snakefile does not
# build.  Rebuild them with the product Snakefile, or (until phase 5 retires the
# old tree) leave the existing ones in place.

# ---- validation plots on the combined tables ----
rule plots:
    input:
        donuts = "output/fam_processing/{ps}/donuts.parquet",
        fits   = "output/fam_processing/{ps}/fits.parquet",
        script = "code/dzfit/run_dz_plots.py",
    output: "output/dzfit/{ps}/trio_comparison_all.pdf"
    params: coord = lambda w: coord(PS_BY_DIR[w.ps])
    # run_dz_plots loads the full combined donut table; astropy materializes the
    # zk_* list columns as Python objects, so a single job can use ~10 GiB for a
    # multi-million-row set.  Declare it large so the scheduler runs plots one at
    # a time (two concurrent jobs OOM the 16 GiB allocation).
    resources: mem_mb=12000
    log: "logs/{ps}.plots.log"
    shell:
        "python code/dzfit/run_dz_plots.py {input.donuts} {input.fits} "
        "--coord-sys {params.coord} --output-dir output/dzfit/{wildcards.ps} "
        "--no-single-image > {log} 2>&1"

# ---- per-visit residual-map movie, one movie per chunk ----
# One frame per visit of the k<=6 fit residual, strung together by ffmpeg (in
# lsst_distrib).  Per chunk rather than per param_set: the largest chunk is 2.2M donuts
# against 9.1M combined, so the jobs fit in memory, run in parallel and each movie stays
# small.  Not in `rule all` — request `residual_movies` explicitly.
rule residual_movie_chunk:
    input:
        donuts = "output/fam_processing/{ps}/chunks/{dmin}_{dmax}/donuts.parquet",
        fits   = "output/fam_processing/{ps}/chunks/{dmin}_{dmax}/fits.parquet",
        script = "code/dzfit/run_dz_plots.py",
    # Each chunk renders into its own subdirectory: the intermediate JPEG frames and the
    # ffmpeg `frame_list.txt` are fixed names, so a shared directory would race when the
    # chunks run concurrently.
    output: "output/dzfit/{ps}/movies/{dmin}_{dmax}/residuals_z1toz6_{dmin}_{dmax}.mp4"
    params: coord = lambda w: coord(PS_BY_DIR[w.ps])
    resources: mem_mb=4000
    log: "logs/{ps}.{dmin}_{dmax}.residual_movie.log"
    shell:
        "python code/dzfit/run_dz_plots.py {input.donuts} {input.fits} "
        "--coord-sys {params.coord} --movie-prefix z1toz6 "
        "--movie-name residuals_z1toz6_{wildcards.dmin}_{wildcards.dmax}.mp4 "
        "--output-dir output/dzfit/{wildcards.ps}/movies/{wildcards.dmin}_{wildcards.dmax} "
        "--no-fit-params --no-trio > {log} 2>&1"

rule residual_movies:
    input:
        lambda w: [f"output/dzfit/{w.ps}/movies/{a}_{b}/residuals_z1toz6_{a}_{b}.mp4"
                   for a, b in chunks(PS_BY_DIR[w.ps])]
    output: touch("output/dzfit/{ps}/movies/all_movies.done")

# ---- k<=3 vs k<=6 DZ fit check ----
