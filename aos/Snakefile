# `rule wfs_mktable` moved to rubinwork/products/cwfs_tables/Snakefile in phase 3a of
# notes/status/organization_plan.md, with the builder.  The study rules below still read
# the ingested tables at the paths they always did —
# output/wfs_ingest/<ps>/<cwfs>/donuts.parquet — so those are now inputs this Snakefile
# does not build, exactly as the FAM tables became in phase 2.  Build them with:
#
#   snakemake -s rubinwork/products/cwfs_tables/Snakefile \
#       --config variant=d12-refitWcs build=<YYYYMMDD> fam_build=<YYYYMMDD>
#
# The wfs_variants / wfs_collection / WFS_*DVARIANTS helpers stay: the study rules use
# them to enumerate the cwfs variants.


# ---- coadded FAM MIW-subtracted Z5-Z8 focal-plane maps (one PDF, per-term
#      common color scale; coadd = 12-triplet block at common el/rot/az) ----
# NOT in `rule all` (reads the full multi-GB donuts.parquet); target explicitly:
#   snakemake --rerun-triggers mtime \
#     output/<ps>/<mi>/plots/fam_coadd_miw_maps.pdf
rule fam_coadd_miw:
    input:
        donuts  = lambda w: f"{d_tables(w.d)}/donuts.parquet",
        visits  = lambda w: f"{d_tables(w.d)}/visits.parquet",
        sidecar = "output/miw/{d}/zk_intrinsic.parquet",
        script  = "code/coadd/run_fam_coadd_miw.py",
    output: "output/coadd/{d}/fam_coadd_miw_maps.pdf"
    params:
        real_ps = lambda w: MI_BY_DTAG[w.d][0],
        real_mi = lambda w: MI_BY_DTAG[w.d][1],
        tdir    = lambda w: d_tables(w.d),
        bin_deg = lambda w: an_sec_d("fam_coadd_miw", w.d).get("bin_deg", 1.0),
        mint    = lambda w: an_sec_d("fam_coadd_miw", w.d).get("min_triplets", 6),
        grid    = lambda w: an_sec_d("fam_coadd_miw", w.d).get("grid_n", 24),
        pct     = lambda w: an_sec_d("fam_coadd_miw", w.d).get("pct", 98.0),
    resources: mem_mb=12000
    log: "logs/{d}.fam_coadd_miw.log"
    shell:
        "python code/coadd/run_fam_coadd_miw.py --param-set {params.real_ps} "
        "--mi-name {params.real_mi} --bin-deg {params.bin_deg} "
        "--min-triplets {params.mint} --grid-n {params.grid} --pct {params.pct} "
        "--tables-dir {params.tdir} --miw-dir output/miw/{wildcards.d} "
        "--out-dir output/coadd/{wildcards.d} > {log} 2>&1"


