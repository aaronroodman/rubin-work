# ---- FAM bounce-test paired Δ (DZ / v-mode / DOF) on the MI-refit fits ----
# fits.parquet now holds ALL visits (--no-quality-cut); the bounce applies a
# relaxed CCD-count cut (--min-detectors 160) so marginal low-CCD elevation-40
# points are kept.  Other consumers apply visit_quality_pass (nd>=170).
rule bounce:
    input:
        fits     = "output/miw/{d}/fits.parquet",
        script   = "code/bounce/run_bounce.py",
        lib      = "code/bounce/bounce_lib.py",
        ofc      = f"{WF_LIB}/ofc_svd.py",
    output:
        summary = "output/bounce/{d}/bounce_summary.pdf",
        stats   = "output/bounce/{d}/bounce_kj_stats.parquet",
    params:
        real_ps = lambda w: MI_BY_DTAG[w.d][0],
        real_mi = lambda w: MI_BY_DTAG[w.d][1],
        acfg    = lambda w: an_json_d("bounce", w.d),   # rerun-trigger only
    resources: mem_mb=4000
    log: "logs/{d}.bounce.log"
    shell:
        "python code/bounce/run_bounce.py --param-set {params.real_ps} "
        "--mi-name {params.real_mi} --fits {input.fits} "
        "--out-dir output/bounce/{wildcards.d} --min-detectors 160 > {log} 2>&1"

# ======================================================================
# In-focus corner-WFS (cwfs) track — paired to the FAM triplets.
# Runs AFTER Phase 1 (needs the combined FAM visits/fits).  RSP-only (Butler).
