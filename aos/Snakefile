# ---- DZ-to-DZ correlations on the MI-refit fits (raw + optical-corrected) ----
# One run emits BOTH PDFs from a shared (raw) selection: dz_correlations.pdf and
# dz_correlations_optcorr.pdf, where the optcorr panels overlay the corrected DZ
# (W_resid = (I - U_eff U_effᵀ)·W) on the raw points/fit at the raw axis limits.
# Needs ofc_svd (lsst.ts.ofc) for the correction -> RSP-only.
rule dz_correlations:
    input:
        fits   = "output/miw/{d}/fits.parquet",
        script = "code/correlations/run_dz_correlations.py",
        lib    = "code/dz_plotting.py",
        ofc    = f"{WF_LIB}/ofc_svd.py",
    output:
        pdf    = "output/correlations/{d}/dz_correlations.pdf",
        pairs  = "output/correlations/{d}/dz_correlations_pairs.parquet",
        opdf   = "output/correlations/{d}/dz_correlations_optcorr.pdf",
        opairs = "output/correlations/{d}/dz_correlations_optcorr_pairs.parquet",
    params:
        real_ps = lambda w: MI_BY_DTAG[w.d][0],
        real_mi = lambda w: MI_BY_DTAG[w.d][1],
        # rerun-trigger only
        acfg    = lambda w: an_json_d("dz_correlations", w.d),
        cfg     = lambda w: mi_cfg_json(w.d),          # n_dof/n_keep/SVD params
    resources: mem_mb=4000
    log: "logs/{d}.dz_correlations.log"
    shell:
        "python code/correlations/run_dz_correlations.py --param-set {params.real_ps} "
        "--mi-name {params.real_mi} --fits {input.fits} "
        "--out-dir output/correlations/{wildcards.d} > {log} 2>&1"

