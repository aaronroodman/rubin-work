# ===== Jupyter =====
.ipynb_checkpoints/

# ===== Python =====
__pycache__/
*.pyc
*.pyo
*.egg-info/
*.egg
dist/
build/
.eggs/
*.so

# ===== Virtual environments =====
.venv/
venv/
env/

# ===== Output directories (large/ephemeral outputs) =====
# Keep .gitkeep files but ignore everything else in output/
*/output/*
!*/output/.gitkeep
# Products belong in <topic>/output/, but the pattern above needs a directory
# component before output/, so a REPO-ROOT output/ would slip through untracked.
/output/
# NOTE: do NOT add a .gitkeep under aos/output, blocks/output, value_added/output,
# guider/output or optatmo/output.  On the USDF RSP those output/ dirs are SYMLINKS to
# /sdf/group/rubin/u/roodman/LSST/notebooks/rubin-work/<topic>/output (disk quota).
# git sees a symlink as a file, so a tracked .gitkeep inside them makes `git pull`
# abort on S3DF with
# "untracked working tree files would be overwritten by merge: aos/output".
# The remaining topics' output/ dirs are real directories there and keep their .gitkeep.
# Archived output snapshots (e.g. aos/output-backup/) — never track these.
*-backup/

# ===== Log directories (per-run logs are ephemeral) =====
*/logs/*
!*/logs/.gitkeep
# As with output/ above, the pattern needs a directory component before logs/, so a
# REPO-ROOT logs/ would otherwise slip through untracked.
/logs/

# ===== Large data files =====
*.fits
*.fits.gz
*.fits.fz
*.fz
*.parquet
*.hdf5
*.h5
*.pkl
*.pickle

# Exception: versioned AOS calibration products are small and tracked on purpose
# (see aos/calibration/README.md). Negation must come after the *.parquet rule.
!aos/calibration/**/*.parquet

# ===== OS clutter =====
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# ===== Editor/IDE =====
.vscode/
.idea/
*.swp
*.swo
*~

# ===== Snakemake =====
# Per-topic pipeline state (locks, metadata, conda/singularity caches).
# Present in aos/, guider/, optatmo/ and created by any future Snakefile.
.snakemake/

# ===== Misc =====
.env
*.log

# Session handoff snapshots (local-only, not auto-updated)
aos/AOS_SESSION_HANDOFF.md
aos/SESSION_HANDOFF.md

# On the USDF RSP aos/output, blocks/output, value_added/output, guider/output and
# optatmo/output are SYMLINKS (see the note above).  */output/* ignores their CONTENTS but
# not the symlink paths themselves, so without these lines they show up as untracked files
# on S3DF.
/aos/output
/blocks/output
/value_added/output
/guider/output
/optatmo/output

# Generated by optatmo/code/build_fam_manifest.py --out pipelines/prod_famcwfs.txt
optatmo/pipelines/prod_famcwfs.txt

# ===== Claude Code session state =====
# Machine-local: per-project session transcripts, plans and settings.local.json, plus a
# live working copy of Claude's memory.  The memory SNAPSHOT that belongs in git is
# notes/claude-memory/ -- it is the fuller one (the live index carries a subset), so
# tracking .claude/ as well would let the thinner copy overwrite it.
.claude/*
!.claude/skills/

# Scratch notebooks -- throwaway, for testing code development. Deliberately untracked
# (they were swept into commits three times by `git add -A` before being ignored here).
*snippets.ipynb
# nbconvert --execute writes an executed copy alongside the source; never track it.
_exectest.ipynb
*-exectest.ipynb
Untitled*.ipynb
