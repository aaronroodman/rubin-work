# ----------------------------------------------------------------------
# BLOCK-T539 closed-loop AOS state + per-night telemetry pipeline (Snakemake).
#
#   build_table  (RSP: ConsDB + EFD)  ->  plots       # converged T539 images
#   night_table  (RSP: ConsDB + EFD)                  # all visits, one night
#
#   ./run_snake.sh -n      # dry-run: show the plan
#   ./run_snake.sh         # build (local, detached; tuned for the RSP)
#   ./run_snake.sh output/night_table_20260629.parquet   # just one night
#
# Layout:
#   output/t539_closedloop_aos_<dmin>_<dmax>.parquet   (converged-image table)
#   output/t539_validation_<dmin>_<dmax>.pdf           (v-modes + telemetry QA)
#   output/night_table_<day_obs>.parquet               (all visits in a night)
#
# Config: config.yaml (day_obs range, `nights`, ConsDB/EFD, OFC, selection).
# Both tables share code/telemetry_pipeline.collect_telemetry, which reuses
# aos/code (DOF/LUT/v-modes/Zernikes) + olr/code/telemetry.py (thermal/wind).
# ----------------------------------------------------------------------
import os
import yaml

# One thread per job; parallelism via `snakemake -j` (mirrors olr/aos).
for _v in ("OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS",
           "NUMEXPR_NUM_THREADS"):
    os.environ[_v] = "1"

CFG = yaml.safe_load(open("config.yaml"))
TAG = f"{CFG['day_obs_min']}_{CFG['day_obs_max']}"
NIGHTS = [str(n) for n in CFG.get("nights", [])]


rule all:
    input:
        f"output/t539_closedloop_aos_{TAG}.parquet",
        f"output/t539_validation_{TAG}.pdf",
        expand("output/night_table_{night}.parquet", night=NIGHTS),


# --- RSP-only: ConsDB select + DOF + v-modes + Zernikes + thermal/wind ---
rule build_table:
    output:
        table = f"output/t539_closedloop_aos_{TAG}.parquet",
    input:
        script    = "code/build_t539_table.py",
        lib_pipe  = "code/telemetry_pipeline.py",
        lib_trim  = "../aos/code/aos_trim.py",
        lib_state = "../aos/code/aos_state.py",
        lib_tele  = "../olr/code/telemetry.py",
    params:
        dmin = CFG["day_obs_min"],
        dmax = CFG["day_obs_max"],
        instrument = CFG["instrument"],
        consdb = CFG["consdb_url"],
        efd = CFG["efd"],
        ofc = CFG["ofc_config_dir"],
        ann = " ".join(CFG["annotations"]),
        prefix = CFG["science_program_prefix"],
        reason = CFG["observation_reason"],
        seq_gap = CFG["seq_gap_max"],
        n_vmode = CFG["n_vmode"],
        tsrc = CFG.get("telemetry_source", "consdb"),
    resources:
        mem_mb = 8000,
    log:
        "logs/build_table.log",
    shell:
        "python code/build_t539_table.py "
        "--day-obs-min {params.dmin} --day-obs-max {params.dmax} "
        "--instrument {params.instrument} --consdb-url {params.consdb} "
        "--efd {params.efd} --ofc-config-dir {params.ofc} "
        "--science-program-prefix {params.prefix} "
        "--observation-reason {params.reason} "
        "--seq-gap-max {params.seq_gap} --n-vmode {params.n_vmode} "
        "--telemetry-source {params.tsrc} "
        "--annotations {params.ann} --out {output.table} > {log} 2>&1"


# --- Validation plots (v-mode histograms + telemetry QA) ---
rule plots:
    output:
        pdf = f"output/t539_validation_{TAG}.pdf",
    input:
        table  = f"output/t539_closedloop_aos_{TAG}.parquet",
        script = "code/plot_t539_validation.py",
    resources:
        mem_mb = 2000,
    log:
        "logs/plots.log",
    shell:
        "python code/plot_t539_validation.py --in {input.table} "
        "--out {output.pdf} > {log} 2>&1"


# --- Per-night full-telemetry table: all science visits in one night, same
#     collector as the T539 table.  For the mirror-mode-vs-elevation study. ---
rule night_table:
    output:
        table = "output/night_table_{night}.parquet",
    input:
        script    = "code/build_night_table.py",
        lib_pipe  = "code/telemetry_pipeline.py",
        lib_trim  = "../aos/code/aos_trim.py",
        lib_state = "../aos/code/aos_state.py",
        lib_tele  = "../olr/code/telemetry.py",
    params:
        instrument = CFG["instrument"],
        consdb = CFG["consdb_url"],
        efd = CFG["efd"],
        ofc = CFG["ofc_config_dir"],
        n_vmode = CFG["n_vmode"],
        tsrc = CFG.get("telemetry_source", "consdb"),
    resources:
        mem_mb = 8000,
    log:
        "logs/night_table_{night}.log",
    shell:
        "python code/build_night_table.py --day-obs {wildcards.night} "
        "--instrument {params.instrument} --consdb-url {params.consdb} "
        "--efd {params.efd} --ofc-config-dir {params.ofc} "
        "--n-vmode {params.n_vmode} --telemetry-source {params.tsrc} "
        "--out {output.table} > {log} 2>&1"
