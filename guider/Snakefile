# ----------------------------------------------------------------------
# Guider moment-decomposition pipeline (Snakemake), per whole night.
#
# discover_night (Butler query, science-only) -> one job per exposure
#   -> seq/<seqNum>_{moments,stars,metrics}.parquet
#   -> combine into per-day single files + a per-day QA/summary PDF.
#
#   snakemake -n                                        # dry-run
#   snakemake output/night_20260709/guider_moments_20260709.parquet
#   ./run_snake.sh --day-obs 20260709[,20260710,...] [--mode batch] [--limit N]
#
# Per-day outputs (output/night_<dayObs>/):
#   seq/<seqNum>_moments.parquet     NEW: unweighted moment decomposition
#   seq/<seqNum>_stars.parquet       summit_utils per-stamp tracker table
#   seq/<seqNum>_metrics.parquet     summit_utils per-exposure metrics
#   guider_moments_<dayObs>.parquet  per-day combined (yours)
#   guider_stars_<dayObs>.parquet    per-day combined (summit_utils stars)
#   guider_metrics_<dayObs>.parquet  per-day combined (summit_utils metrics)
#   guider_plots_<dayObs>.pdf        per-day QA/summary PDF
#   movies/<seqNum>_{full,star}.mp4  RubinTV-style movies, every Nth visit
#   guider_movies_<dayObs>.txt       movie manifest (movie_stride in config)
#   skipped_visits.txt
# ----------------------------------------------------------------------
import os
import yaml

os.environ["NUMEXPR_MAX_THREADS"] = "8"
os.environ["NUMEXPR_NUM_THREADS"] = "1"
os.environ["OMP_NUM_THREADS"] = "1"
os.environ["OPENBLAS_NUM_THREADS"] = "1"
os.environ["MKL_NUM_THREADS"] = "1"

CFG = yaml.safe_load(open("snake_config.yaml"))
BUTLER = CFG["butler"]
TRACKER = CFG["tracker"]
MOMENTS = CFG["moments"]
NIGHTS = [int(d) for d in CFG.get("nights", [])]
COLLECTIONS = " ".join(BUTLER["collections"])
GUIDER_HZ = CFG.get("guider_hz", 5.0)
IMAGE_TYPES = " ".join(CFG.get("image_types", ["science"]))
SCIENCE_REPO = CFG.get("science_repo", "/repo/main")
LIMIT = int(config.get("limit", 0))   # CLI: --config limit=N (smoke test)

CODE = "code"


MOVIE_STRIDE = int(config.get("movie_stride", 50))  # movie for every Nth visit (0=off)
RESIDUAL_SCALE = float(TRACKER.get("residual_scale", 5.0))  # trend outlier band (x mad_std)


def nightMomentsFiles(wildcards):
    """Per-seq moments files for a night, from the discovery checkpoint."""
    dayObs = int(wildcards.dayObs)
    manifest = checkpoints.discover_night.get(dayObs=wildcards.dayObs).output[0]
    with open(manifest) as fh:
        seqs = [int(x) for x in fh.read().split() if x.strip()]
    return [f"output/night_{dayObs}/seq/{s}_moments.parquet" for s in seqs]


def nightMovieFiles(wildcards):
    """RubinTV-style movies for every MOVIE_STRIDE-th visit of a night."""
    dayObs = int(wildcards.dayObs)
    manifest = checkpoints.discover_night.get(dayObs=wildcards.dayObs).output[0]
    with open(manifest) as fh:
        seqs = sorted(int(x) for x in fh.read().split() if x.strip())
    picked = seqs[::MOVIE_STRIDE] if MOVIE_STRIDE > 0 else []
    return [f"output/night_{dayObs}/movies/{s}_{kind}.mp4"
            for s in picked for kind in ("full", "star")]


def nightRtvPlotFiles(wildcards):
    """RubinTV-style review plots for every MOVIE_STRIDE-th visit of a night."""
    dayObs = int(wildcards.dayObs)
    manifest = checkpoints.discover_night.get(dayObs=wildcards.dayObs).output[0]
    with open(manifest) as fh:
        seqs = sorted(int(x) for x in fh.read().split() if x.strip())
    picked = seqs[::MOVIE_STRIDE] if MOVIE_STRIDE > 0 else []
    return [f"output/night_{dayObs}/rtvplots/{s}_rtvplots.pdf" for s in picked]


wildcard_constraints:
    dayObs = r"\d{8}",
    seqNum = r"\d+",


rule all:
    input:
        [f"output/night_{d}/guider_moments_{d}.parquet" for d in NIGHTS]
        + [f"output/night_{d}/guider_plots_{d}.pdf" for d in NIGHTS]
        + [f"output/night_{d}/guider_psfmoments_{d}.parquet" for d in NIGHTS]
        + [f"output/night_{d}/guider_movies_{d}.txt" for d in NIGHTS]
        + [f"output/night_{d}/guider_rtvplots_{d}.txt" for d in NIGHTS],


checkpoint discover_night:
    output:
        "output/night_{dayObs}/exposures.txt",
    params:
        limit=LIMIT,
        imageTypes=IMAGE_TYPES,
    resources:
        mem_mb=2000,
    log:
        "logs/night_{dayObs}.discover.log",
    shell:
        f"""
        python {CODE}/list_guider_exposures.py --day-obs {{wildcards.dayObs}} \
            --repo {BUTLER["repo"]} --collections {COLLECTIONS} \
            --image-types {{params.imageTypes}} --limit {{params.limit}} \
            --output {{output}} > {{log}} 2>&1
        """


# ---- per exposure: 3 products (moments / stars / metrics) ----
rule moments:
    output:
        moments="output/night_{dayObs}/seq/{seqNum}_moments.parquet",
        stars="output/night_{dayObs}/seq/{seqNum}_stars.parquet",
        metrics="output/night_{dayObs}/seq/{seqNum}_metrics.parquet",
    params:
        seqdir="output/night_{dayObs}/seq",
        recover=lambda w: "" if TRACKER.get("recover_edge_stars", True) else "--no-recover-edge-stars",
    resources:
        mem_mb=4000,
    log:
        "logs/night_{dayObs}.{seqNum}.moments.log",
    shell:
        rf"""
        python {CODE}/run_guider_moments.py \
            --day-obs {{wildcards.dayObs}} --seq-num {{wildcards.seqNum}} \
            --outdir {{params.seqdir}} \
            --repo {BUTLER["repo"]} --collections {COLLECTIONS} \
            --view {BUTLER["view"]} --guider-hz {GUIDER_HZ} \
            --min-snr {TRACKER["min_snr"]} --max-ellipticity {TRACKER["max_ellipticity"]} \
            --edge-margin {TRACKER["edge_margin"]} \
            --min-finite-fraction {TRACKER["min_finite_fraction"]} {{params.recover}} \
            --ap-nsigma {MOMENTS["ap_nsigma"]} --cen-niter {MOMENTS["cen_niter"]} \
            --residual-scale {RESIDUAL_SCALE} \
            > {{log}} 2>&1
        """


# ---- combine per-seq -> per-day single files (+ skip report) ----
rule combine:
    input:
        nightMomentsFiles,
    output:
        moments="output/night_{dayObs}/guider_moments_{dayObs}.parquet",
        stars="output/night_{dayObs}/guider_stars_{dayObs}.parquet",
        metrics="output/night_{dayObs}/guider_metrics_{dayObs}.parquet",
        skipped="output/night_{dayObs}/skipped_visits.txt",
    resources:
        mem_mb=3000,
    log:
        "logs/night_{dayObs}.combine.log",
    shell:
        f"""
        python {CODE}/combine_moments.py \
            --seqdir output/night_{{wildcards.dayObs}}/seq \
            --outdir output/night_{{wildcards.dayObs}} --dayobs {{wildcards.dayObs}} \
            > {{log}} 2>&1
        """


# ---- adjacent-CCD PSF star moments (science side; independent of guider) ----
rule psfmoments:
    output:
        "output/night_{dayObs}/guider_psfmoments_{dayObs}.parquet",
    resources:
        mem_mb=6000,
    log:
        "logs/night_{dayObs}.psfmoments.log",
    shell:
        f"""
        python {CODE}/extract_adjacent_psf_moments.py --day-obs {{wildcards.dayObs}} \
            --out output/night_{{wildcards.dayObs}} --repo {SCIENCE_REPO} \
            --image-types {IMAGE_TYPES} --limit {LIMIT} > {{log}} 2>&1
        """


# ---- RubinTV-style movies for a strided subset of visits ----
rule movie:
    output:
        full="output/night_{dayObs}/movies/{seqNum}_full.mp4",
        star="output/night_{dayObs}/movies/{seqNum}_star.mp4",
    params:
        moviedir="output/night_{dayObs}/movies",
        recover=lambda w: "" if TRACKER.get("recover_edge_stars", True) else "--no-recover-edge-stars",
    resources:
        mem_mb=4000,
    log:
        "logs/night_{dayObs}.{seqNum}.movie.log",
    shell:
        rf"""
        python {CODE}/run_guider_movie.py \
            --day-obs {{wildcards.dayObs}} --seq-num {{wildcards.seqNum}} \
            --outdir {{params.moviedir}} \
            --repo {BUTLER["repo"]} --collections {COLLECTIONS} \
            --view {BUTLER["view"]} \
            --min-snr {TRACKER["min_snr"]} --max-ellipticity {TRACKER["max_ellipticity"]} \
            --edge-margin {TRACKER["edge_margin"]} \
            --min-finite-fraction {TRACKER["min_finite_fraction"]} {{params.recover}} \
            > {{log}} 2>&1
        """


rule movies:
    input:
        nightMovieFiles,
    output:
        "output/night_{dayObs}/guider_movies_{dayObs}.txt",
    resources:
        mem_mb=1000,
    shell:
        "ls output/night_{wildcards.dayObs}/movies > {output} 2>/dev/null || "
        "echo 'no movies (movie_stride=0 or empty night)' > {output}"


# ---- RubinTV-style review plots for a strided subset of visits ----
rule rtvplot:
    output:
        "output/night_{dayObs}/rtvplots/{seqNum}_rtvplots.pdf",
    params:
        plotdir="output/night_{dayObs}/rtvplots",
        recover=lambda w: "" if TRACKER.get("recover_edge_stars", True) else "--no-recover-edge-stars",
    resources:
        mem_mb=4000,
    log:
        "logs/night_{dayObs}.{seqNum}.rtvplot.log",
    shell:
        rf"""
        python {CODE}/run_guider_rubintv_plots.py \
            --day-obs {{wildcards.dayObs}} --seq-num {{wildcards.seqNum}} \
            --outdir {{params.plotdir}} \
            --repo {BUTLER["repo"]} --collections {COLLECTIONS} \
            --view {BUTLER["view"]} \
            --min-snr {TRACKER["min_snr"]} --max-ellipticity {TRACKER["max_ellipticity"]} \
            --edge-margin {TRACKER["edge_margin"]} \
            --min-finite-fraction {TRACKER["min_finite_fraction"]} {{params.recover}} \
            --residual-scale {RESIDUAL_SCALE} \
            > {{log}} 2>&1
        """


rule rtvplots:
    input:
        nightRtvPlotFiles,
    output:
        "output/night_{dayObs}/guider_rtvplots_{dayObs}.txt",
    resources:
        mem_mb=1000,
    shell:
        "ls output/night_{wildcards.dayObs}/rtvplots > {output} 2>/dev/null || "
        "echo 'no rtvplots (movie_stride=0 or empty night)' > {output}"


# ---- per-day QA/summary PDF ----
rule plots:
    input:
        "output/night_{dayObs}/guider_moments_{dayObs}.parquet",
    output:
        "output/night_{dayObs}/guider_plots_{dayObs}.pdf",
    resources:
        mem_mb=2000,
    log:
        "logs/night_{dayObs}.plots.log",
    shell:
        f"python {CODE}/run_guider_dayplots.py {{input}} --output {{output}} > {{log}} 2>&1"
